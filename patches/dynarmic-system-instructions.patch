     virtual std::uint64_t GetTicksForCode(bool is_thumb, VAddr vaddr, std::uint32_t instruction) = 0;
+
+    // If this returns true, the instruction is not translated; Exception::SystemInstruction is
+    // raised instead and the callee emulates it in ExceptionRaised. ARM: the callee evaluates
+    // the condition. Thumb: called only when the IT condition passed; 32-bit instructions are
+    // passed as (first halfword << 16) | second halfword.
+    virtual bool IsSystemInstruction(bool /*is_thumb*/, std::uint32_t /*instruction*/) { return false; }
 };
 
